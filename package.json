{
  "name": "streamy",
  "productName": "Streamy",
  "version": "0.1.0",
  "private": true,
  "description": "Watch videos from torrents while they download.",
  "license": "GPL-3.0-or-later",
  "author": "JustArtiom",
  "homepage": "https://github.com/JustArtiom/streamy",
  "repository": "github:JustArtiom/streamy",
  "desktopName": "streamy.desktop",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "icons": "electron scripts/icons.mjs",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "notices": "node scripts/notices.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "hls.js": "^1.7.3",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "supertest": "^7.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "bitfield": "^5.0.1",
    "chardet": "^2.2.0",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "parse-torrent": "^11.0.24",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "webtorrent": "^3.0.21",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "node-datachannel@0.32.3": true,
    "bufferutil": false,
    "utf-8-validate": false,
    "utp-native": false,
    "electron-winstaller": false,
    "fsevents": false,
    "ip-set": false
  }
}
