{
  // The end-to-end tests (e2e/, playwright.config.ts): Node.js, run by
  // Playwright. They drive the built app from outside.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2024",
    // DOM: for the functions page.evaluate() runs inside the window.
    "lib": ["ES2024", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Type checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "playwright.config.ts",
    "e2e",
    // Types for webtorrent (the seeder), which ships none.
    "src/engine/types/webtorrent.d.ts"
  ]
}
